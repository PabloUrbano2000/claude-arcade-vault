# Contact form (app/about) — Resend
# Copy this file to .env.local and fill in the values. Never commit .env.local.

# API key from https://resend.com/api-keys (server-only, never NEXT_PUBLIC_)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives the contact messages.
# With the test sender onboarding@resend.dev, Resend only delivers to the
# email address of your own Resend account.
CONTACT_TO_EMAIL=

# Optional. Defaults to "Arcade Vault <onboarding@resend.dev>".
# To send from your own address you need a verified domain in Resend.
CONTACT_FROM_EMAIL="Arcade Vault <onboarding@resend.dev>"
